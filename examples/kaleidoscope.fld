~fold v1 960x540

input mirror: 80..240 = 150

let t = TIME * 0.3
let high = mirror * sqrt(3) / 2
let cell = vec2(2 * high, 2 * sqrt(3) * high)

func step_up(edge, x) {
    return clamp((x - edge) * 100000, 0, 1)
}

func snap(pt) {
    return pt - vec2(floor(pt.x / cell.x + 0.5), floor(pt.y / cell.y + 0.5)) * cell
}

func nearest(pt) {
    let a = snap(pt)
    let b = snap(pt - cell / 2)
    return mix(b, a, step_up(0, length(b) - length(a)))
}

func folded(pt) {
    let local = nearest(rotate(pt, t * 0.2))
    let turn = mod(angle(local) - TAU / 12, TAU / 3)
    let side = TAU / 6 - abs(turn - TAU / 6)
    return vec2(cos(side), sin(side)) * length(local) * 150 / mirror
}

func seen(sh) {
    return shape(pt => dist(sh, folded(pt)))
}

func diamond(size) {
    return rect(size, size) |> spin(45 * DEG)
}

let ruby = circle(30) |> at(75 + 60 * sin(t * 1.1), 45 + 40 * cos(t * 0.8))
let amber = circle(20) |> at(40 + 50 * cos(t * 0.9 + 1), 70 + 50 * sin(t * 1.3))
let sliver = rounded_rect(104, 16, 8) |> spin(t * 0.7) |> at(90 + 45 * cos(t * 0.6), 30 + 30 * sin(t * 1.2))
let jade = diamond(42) |> spin(-t) |> at(60 + 50 * sin(t * 0.5 + 2), 90 + 30 * cos(t * 0.7))
let hoop = circle(32) |> outline(7) |> at(110 + 35 * sin(t * 0.8 + 3), 60 + 40 * cos(t * 1.1 + 1))
let pearl = circle(7) |> at(30 + 25 * sin(t * 1.7), 20 + 20 * cos(t * 1.3 + 2))
let speck = circle(4) |> at(120 + 20 * cos(t * 2.1), 25 + 15 * sin(t * 1.9))

let q = folded(POS)
let base = mix(#0b0820, #24164d, noise(q / 45 + vec2(t * 0.3, 0)))

let flow = q + vec2(t * 14, t * 6)
let spot = vec2(floor(flow.x / 22), floor(flow.y / 22))
let jitter = vec2(hash(spot + vec2(1, 2)), hash(spot + vec2(4, 3))) - vec2(0.5, 0.5)
let middle = (spot + vec2(0.5, 0.5) + jitter * 0.4) * 22
let pick = hash(spot + vec2(7, 7))
let size = (3 + 6 * hash(spot + vec2(9, 1))) * step_up(0.3, hash(spot + vec2(2, 8)))
let bit = clamp((size - length(flow - middle)) / PX + 0.5, 0, 1)
let warm = mix(#ff4d6d, #ffc94d, step_up(0.25, pick))
let cool = mix(#4cc9f0, #52e3a4, step_up(0.75, pick))
let tint = mix(mix(warm, cool, step_up(0.5, pick)), #ffffff, step_up(0.92, pick))

draw FRAME |> fill(base)
draw tint * (0.7 * bit)
draw seen(ruby) |> fill(#ff4d6d * 0.8)
draw seen(sliver) |> fill(#4cc9f0 * 0.75)
draw seen(jade) |> fill(#52e3a4 * 0.75)
draw seen(amber) |> fill(#ffc94d * 0.85)
draw seen(hoop) |> fill(#f72585 * 0.9)
draw seen(pearl) |> fill(#ffffff)
draw seen(speck) |> fill(#fff3b0)
draw #000000 * (0.75 * smoothstep(240, 560, length(POS)))
