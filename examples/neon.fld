~fold v1 960x540

input buzz: 0..1 = 0.5

func step_down(x, edge) {
    return 1 - clamp((x - edge) * 1000, 0, 1)
}

func flicker(seed) {
    let off = step_down(hash(vec2(floor(TIME * 12), seed)), 0.5 * buzz)
    let burst = step_down(hash(vec2(floor(TIME * 0.7), seed + 3)), 0.3 * buzz)
    return 1 - off * burst
}

func halo(sh, col, amt) {
    let d = max(dist(sh, POS), 0)
    return col * (exp(-d / amt) * smoothstep(amt * 5, amt, d))
}

func bounded(sh, x, y, r) {
    return shape(pt => max(dist(sh, pt), length(pt - vec2(x, y)) - r))
}

func tube(sh, col, lit) {
    let line = sh |> outline(5)
    let bloom = (line |> halo(col, 9)) * 0.7 + (line |> halo(col, 38)) * 0.16
    return bloom * lit + (line |> fill(mix(col, #ffffff, 0.55))) * (0.25 + 0.75 * lit)
}

let course = floor(POS.y / 26)
let along = (POS.x + mod(course, 2) * 26) / 52
let joint = min(13 - abs((fract(POS.y / 26) - 0.5) * 26), 26 - abs((fract(along) - 0.5) * 52))
let tint = hash(vec2(floor(along), course)) * 0.18 + noise(POS / 6) * 0.08
let wall = mix(#060304, shade(#1e0e11, tint - 0.2), smoothstep(1.5, 3, joint))

let o = circle(34) |> at(-190, -60) |> bounded(-190, -60, 36)
let p = union(segment(vec2(-120, -94), vec2(-120, -26)), intersect(circle(20) |> at(-112, -74), rect(30, 60) |> at(-97, -74))) |> union(segment(vec2(-120, -94), vec2(-112, -94))) |> union(segment(vec2(-120, -54), vec2(-112, -54))) |> bounded(-110, -60, 40)
let e = union(union(segment(vec2(-60, -94), vec2(-60, -26)), segment(vec2(-60, -94), vec2(-28, -94))), union(segment(vec2(-60, -60), vec2(-34, -60)), segment(vec2(-60, -26), vec2(-28, -26)))) |> bounded(-44, -60, 40)
let n = union(union(segment(vec2(0, -26), vec2(0, -94)), segment(vec2(0, -94), vec2(36, -26))), segment(vec2(36, -26), vec2(36, -94))) |> bounded(18, -60, 42)
let word = union(union(o, p), union(e, n))

let glass = union(union(segment(vec2(170, -100), vec2(250, -100)), segment(vec2(170, -100), vec2(210, -50))), union(segment(vec2(250, -100), vec2(210, -50)), union(segment(vec2(210, -50), vec2(210, -8)), segment(vec2(190, -8), vec2(230, -8))))) |> bounded(210, -54, 70)
let olive = circle(7) |> at(222, -84)

func heart_dist(q) {
    let lobes = min(length(q - vec2(-14, -10)), length(q - vec2(14, -10))) - 18
    return min(lobes, dist(rect(34, 34) |> spin(45 * DEG), q - vec2(0, 5)))
}

let heart = shape(pt => heart_dist(pt - vec2(-150, 120)))

let chase = floor(mod(TIME * 4, 6))
func chevron(i) {
    let x = 40 + i * 34
    let sh = union(segment(vec2(x, 100), vec2(x + 18, 120)), segment(vec2(x + 18, 120), vec2(x, 140))) |> bounded(x + 9, 120, 24)
    let on = 1 - min(abs(i - chase), 1)
    return tube(sh, #ffd23f, 1) * (0.2 + 0.8 * on)
}

draw wall
draw FRAME |> fill(#000000 * (0.5 * smoothstep(250, 520, length(POS * vec2(0.8, 1.3)))))
draw tube(word, #ff3d7f, flicker(1))
draw tube(glass, #3de0ff, 1)
draw tube(olive, #7dff6a, 1)
draw tube(heart, #ff4fd8, 1)
draw chevron(0)
draw chevron(1)
draw chevron(2)
draw chevron(3)
draw chevron(4)
draw chevron(5)
