~fold v1 960x540

input sea: 0..1 = 0.4

let levels = 16
let tide = (sea + 0.025 * sin(TIME * 0.6)) * levels

func height(pt) {
    let p = pt / 300 + vec2(TIME * 0.02, TIME * 0.012)
    let q = pt / 300 - vec2(TIME * 0.016, -TIME * 0.01)
    let broad = noise(p) * 0.55 + noise(q * 2.1 + vec2(5.2, 1.3)) * 0.27
    let fine = noise(p * 4.3 + vec2(1.7, 9.2)) * 0.12 + noise(q * 8.7) * 0.06
    return (broad + fine - 0.22) * 1.6 * levels
}

let here = height(POS)
let grade = vec2(height(POS + vec2(1, 0)) - here, height(POS + vec2(0, 1)) - here)
let slope = max(length(grade), 0.0001)
let relief = clamp(0.92 - (grade.x + grade.y) * 6.5, 0.4, 1.5)
let step = floor(here + 0.5)
let apart = abs(here - step) / slope / PX
let major = 1 - min(mod(step, 4), 1)
let width = 0.5 + 0.9 * major
let line = clamp(width + 0.5 - apart, 0, 1)

let band = floor(here)
let wet = clamp(0.5 - (here - tide) / slope / PX, 0, 1)
let rise = clamp((band - tide) / (levels - tide), 0, 1)
let deep = clamp((tide - band - 1) / 5, 0, 1)

let land = mix(mix(mix(#8fb07a, #c8c283, smoothstep(0, 0.35, rise)), #b98a5e, smoothstep(0.35, 0.7, rise)), #f3eee2, smoothstep(0.75, 0.95, rise))
let water = mix(#4d9db3, #1d4a6b, deep)
let shore = clamp(1.8 + 0.5 - abs(here - tide) / slope / PX, 0, 1)

draw FRAME |> fill(mix(lit(land, #ffffff * relief), water, wet))
draw mix(#5b4633, #a9d6df, wet) * (line * (0.55 + 0.35 * major))
draw #2c3b47 * shore
