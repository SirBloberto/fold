~fold v1 960x540

input film: 0.5..3 = 1.6

func centre_of(x, y, speed, seed) {
    let rise = mod(y - TIME * speed + 420, 840) - 420
    return vec2(x + 34 * sin(TIME * 0.5 + seed) + 10 * sin(TIME * 1.3 + seed * 2), rise)
}

func cube(x) {
    return x * x * x
}

func sheen(centre, r, seed) {
    let q = (POS - centre) / r
    let rr = min(length(q), 1)
    let swirl = noise(q * 2.6 + vec2(seed * 7, TIME * 0.35)) * 0.7
    let thick = (0.25 + 0.5 * (q.y * 0.5 + 0.5) + swirl) * film
    let edge = 0.05 + 0.85 * rr * rr * rr * rr
    let glint = 1 - smoothstep(0.05, 0.2, length(q - vec2(-0.38, -0.42)))
    let warm = cube(0.5 + 0.5 * cos(TAU * thick))
    let cool = cube(0.5 + 0.5 * cos(TAU * (thick + 1 / 3)))
    let gold = cube(0.5 + 0.5 * cos(TAU * (thick + 2 / 3)))
    let film_colour = (#ff4fc8 * warm + #3fd8ff * cool + #ffcc3f * gold) * (edge / max(warm + cool + gold, 0.1))
    let window = 1 - smoothstep(0.08, 0.16, length((q - vec2(0.42, 0.45)) / vec2(1.6, 0.7)))
    return film_colour + #ffffff * (0.9 * glint + 0.35 * window)
}

func bubble(x, y, r, speed, seed) {
    let centre = centre_of(x, y, speed, seed)
    return circle(r) |> at(centre.x, centre.y) |> fill(sheen(centre, r, seed))
}

let sky = mix(#fdf3ff, #cfe9f7, smoothstep(-270, 270, POS.y))
let blur = mix(#ffe1ec, #d7f0ff, 0.5 + 0.5 * sin(POS.x * 0.004 + TIME * 0.1))

draw FRAME |> fill(sky)
draw circle(180) |> at(-330, 120) |> soft(blur * 0.35, 60)
draw circle(140) |> at(360, -110) |> soft(#fff4d6 * 0.4, 60)
draw bubble(-300, 120, 112, 22, 1)
draw bubble(-40, -60, 76, 30, 2)
draw bubble(250, 200, 128, 18, 3)
draw bubble(390, -160, 54, 36, 4)
draw bubble(110, 330, 62, 27, 5)
draw bubble(-420, -250, 46, 33, 6)
draw bubble(-170, 400, 88, 24, 7)
